# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Shopify Admin GraphQL via Client Credentials Grant
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Shopify app client secret used to verify webhook HMAC
SHOPIFY_WEBHOOK_SECRET=

# CJdropshipping API
CJ_ACCESS_TOKEN=
CJ_PLATFORM_TOKEN=
CJ_OPEN_ID=
# Required for automatic order creation; use a logistics name available in your CJ account
CJ_LOGISTIC_NAME=
CJ_FROM_COUNTRY_CODE=CN

# Agent safety
# approval = queue every CJ order; autopilot = submit paid orders automatically within limits
AGENT_MODE=approval
DASHBOARD_SECRET=change-me
MAX_AUTO_CJ_USD=100
MAX_DAILY_CJ_USD=500
DATA_DIR=./data
PORT=3000
